# Frontend-only migration: the public site does not require these to render.
# Keep them for the scaffolded TanStack integrations and future backend work.

# Optional canonical site origin for discovery docs and agent-friendly metadata.
VITE_PUBLIC_SITE_URL=

# Optional for Google Maps-powered directions widgets.
VITE_PUBLIC_MAP_API_KEY=

# Optional Sentry integration from the TanStack CLI scaffold.
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional Better Auth scaffold values.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Optional Neon / Drizzle scaffold values.
DATABASE_URL=
DATABASE_URL_POOLER=
